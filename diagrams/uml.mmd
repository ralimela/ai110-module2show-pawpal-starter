classDiagram
    %% PawPal+ class diagram
    %% Keep this file updated so it matches your final implementation.

    class Owner {
        +str name
        +List~Pet~ pets
        +add_pet(pet: Pet) None
        +get_all_tasks() List~Task~
    }

    class Pet {
        +str name
        +str species
        +int age
        +List~Task~ tasks
        +add_task(task: Task) None
        +remove_task(task: Task) None
        +get_tasks() List~Task~
        +reschedule_task(task: Task, from_date: date, new_date: date) None
    }

    class Task {
        +str title
        +str category
        +int duration_minutes
        +str priority
        +date due_date
        +str frequency
        +time start_time
        +str pet_name
        +List~date~ completed_dates
        +List~date~ skipped_dates
        +mark_complete(day: date) None
        +is_completed_on(day: date) bool
        +priority_rank() int
        +occurs_on(day: date) bool
    }

    class Scheduler {
        +Owner owner
        +get_daily_tasks(day: date) List~Task~
        +get_weekly_calendar(start_day: date) dict
        +total_duration(day: date) int
        +detect_conflicts(day: date) List~tuple~
        +filter_tasks(day: date, pet_name: str, completed: bool) List~Task~
    }

    Owner "1" o-- "*" Pet : has
    Pet "1" *-- "*" Task : has
    Scheduler --> Owner : uses
